# Build output
/target

# Secrets — never commit these.
# The ESV API token belongs in .env, loaded at runtime via std::env::var.
# A committed secret stays in git history forever, even if a later commit
# removes the line, so keep it out of the first commit rather than fixing later.
.env
.env.*
!.env.example

# Local editor / OS noise
*.swp
.DS_Store
/.claude
